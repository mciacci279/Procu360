@page "/cuenta/ingresar"
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http

<PageTitle>Ingresar · Procu360</PageTitle>

<MarcoAcceso>
    <h1>Ingresar</h1>
    <p class="saludo">Bienvenido/a. Ingresá con tu cuenta del Estudio.</p>

    @if (Error is not null)
    {
        <div class="alert alert-danger" role="alert">@MensajeDeError(Error)</div>
    }
    @if (Aceptada == 1)
    {
        <div class="alert alert-success" role="status">Invitación aceptada. Ya podés ingresar.</div>
    }

    <form method="post" action="/cuenta/ingresar">
        <input type="hidden" name="__RequestVerificationToken" value="@_token" />
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <div class="campo-icono">
                <Icono Nombre="invitaciones" Tamano="18" />
                <input class="form-control" id="email" name="email" type="email" required autocomplete="username"
                       placeholder="nombre@estudio.com" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="clave">Contraseña</label>
            <div class="campo-icono">
                <Icono Nombre="candado" Tamano="18" />
                <input class="form-control" id="clave" name="clave" type="password" required autocomplete="current-password" />
            </div>
        </div>
        <button class="btn btn-primary boton-acceso" type="submit">
            Ingresar <Icono Nombre="flecha" Tamano="18" Grosor="2.2" />
        </button>
    </form>

    <p class="nota-acceso">
        <Icono Nombre="escudo" Tamano="16" Grosor="2" />
        Lo que ves depende de tu rol en cada Estudio.
    </p>
</MarcoAcceso>

@code {
    // Token generado desde la request HTTP: liga el formulario a la identidad real de quien lo envía.
    private string _token = string.Empty;

    protected override void OnInitialized() =>
        _token = Antiforgery.GetAndStoreTokens(Http.HttpContext!).RequestToken ?? string.Empty;

    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public int? Aceptada { get; set; }

    // Mensajes genéricos: no revelan si la cuenta existe.
    private static string MensajeDeError(string codigo) => codigo switch
    {
        "bloqueado" => "La cuenta está bloqueada temporalmente por demasiados intentos. Probá más tarde.",
        "sesion" => "Tu sesión terminó porque ya no tenés acceso a ese Estudio.",
        "formulario" => "El formulario venció. Intentá de nuevo.",
        _ => "Email o contraseña incorrectos."
    };
}
