    /// <summary>
    /// Vuelve a leer la ficha después de guardar una sección. Los guardados llegan por un delegado (no por un
    /// EventCallback), así que hay que pedir el redibujado: si no, el encabezado y las secciones quedan con
    /// los datos viejos hasta el próximo evento.
    /// </summary>
    private async Task RecargarAsync()
    {
        _encabezado = await Servicio.EncabezadoAsync(Id);
        await CargarResumenAsync();
        StateHasChanged();
    }

    private static string Importe(decimal valor) => valor.ToString("C2", Argentina);

    /// <summary>
    /// Dos iniciales para el avatar. Solo cuenta palabras que empiezan con letra: un nombre vacío, con solo
    /// signos (", ") o una razón social con siglas ("S.A.") no debe romper la ficha.
    /// </summary>
    private static string Iniciales(string? nombre)
    {
        var partes = (nombre ?? string.Empty)
            .Split([' ', ',', '.', '-', '/'], StringSplitOptions.RemoveEmptyEntries)
            .Where(p => char.IsLetter(p[0]))
            .ToArray();
        return partes.Length switch
        {
            0 => "?",
            1 => char.ToUpperInvariant(partes[0][0]).ToString(),
            _ => string.Concat(char.ToUpperInvariant(partes[0][0]), char.ToUpperInvariant(partes[1][0]))
        };
    }

    private static string NombreEstadoTarea(byte estado) => estado switch
    {
        1 => "Pendiente", 2 => "Cumplida", 3 => "Archivada", 4 => "Anulada", _ => "—"
    };

    private static string ColorEstadoTarea(byte estado) => estado switch
    {
        1 => "ambar", 2 => "verde", _ => "gris"
    };
