@page "/expedientes/{Id:long}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "expedientes.consultar")]
@inject Procu360.Infraestructura.Expedientes.FichaExpedienteServicio Servicio
@inject Procu360.Infraestructura.Expedientes.ServicioEdicionExpediente Edicion
@inject Procu360.Infraestructura.Expedientes.ServicioPersonasExpediente PersonasServicio
@inject Procu360.Infraestructura.Expedientes.ServicioPeriodosExpediente PeriodosServicio
@inject Procu360.Infraestructura.Tareas.ServicioTareas TareasServicio
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject ServicioPermisos Autorizacion

<PageTitle>Expediente @(_encabezado?.NroOrden.ToString("D5") ?? "") · Procu360</PageTitle>

@if (!_visible)
{
    @if (_idCargado is not null)
    {
        <div class="alert alert-secondary" role="status">No encontramos ese expediente en tu alcance.</div>
        <a href="/expedientes">Volver a expedientes</a>
    }
}
else if (_encabezado is not null)
{
    <a href="/expedientes" class="volver"><Icono Nombre="volver" Tamano="16" Grosor="2" /> Volver a resultados</a>

    <section class="tarjeta cabecera-expediente">
        <div style="min-width: 0; flex: 1 1 520px">
            <div class="titulo-expediente">
                <h1>Expediente <span class="numero">@_encabezado.NroOrden.ToString("D5")</span></h1>
                @if (_encabezado.NroExpedienteJudicial is not null)
                {
                    <span class="pastilla gris">Judicial @_encabezado.NroExpedienteJudicial</span>
                }
                @if (_encabezado.Instancia is not null)
                {
                    <span class="pastilla azul">@_encabezado.Instancia</span>
                }
                @if (_encabezado.EtapaActual is not null)
                {
                    <span class="pastilla ambar">Etapa: @_encabezado.EtapaActual</span>
                }
                @if (_encabezado.Anulado)
                {
                    <span class="pastilla roja">Dado de baja</span>
                }
            </div>
            @* Carátula: solo tiene sentido cuando el expediente ya está en el juzgado. *@
            @if (_encabezado.Judicializado)
            {
                <p class="caratula">@(_encabezado.Caratula ?? "Sin carátula")</p>
                @if (_encabezado.Recaratulacion is not null)
                {
                    <p class="small text-muted mb-1">Recaratulado: @_encabezado.Recaratulacion</p>
                }
            }

            @* Lo que identifica al expediente, judicializado o no. *@
            <div class="meta-encabezado">
                <div class="dato">
                    <span class="rotulo">Nro. cuenta</span>
                    <span class="valor numero">@(_encabezado.NroCuenta ?? "—")</span>
                </div>
                <div class="dato">
                    <span class="rotulo">Comitente</span>
                    <span class="valor">@(_encabezado.Comitente ?? "—")</span>
                </div>
                <div class="dato">
                    <span class="rotulo">Demandado</span>
                    <span class="valor">
                        @(string.IsNullOrWhiteSpace(_encabezado.Demandado) ? "—" : _encabezado.Demandado)
                        @if (_encabezado.Codemandados > 0)
                        {
                            <span class="pastilla azul ms-1">+@_encabezado.Codemandados</span>
                        }
                    </span>
                </div>
                <div class="dato">
                    <span class="rotulo">Concepto</span>
                    <span class="valor">@(_encabezado.Concepto ?? "—")</span>
                </div>
            </div>

            @* Datos del juicio: solo si está judicializada. *@
            @if (_encabezado.Judicializado)
            {
                <div class="meta">
                    @if (!string.IsNullOrEmpty(_encabezado.Juzgado))
                    {
                        <span><Icono Nombre="balanza" Tamano="16" /> @_encabezado.Juzgado</span>
                    }
                    @if (!string.IsNullOrEmpty(_encabezado.Procurador))
                    {
                        <span><Icono Nombre="usuarios" Tamano="16" /> @_encabezado.Procurador</span>
                    }
                    @if (_encabezado.FechaSorteo is DateOnly fs)
                    {
                        <span><Icono Nombre="calendario" Tamano="16" /> Sorteo @fs.ToString("dd/MM/yyyy")@(_encabezado.Sorteo is not null ? $" · {_encabezado.Sorteo}" : "")</span>
                    }
                </div>
            }
            else
            {
                <div class="meta">
                    <span class="text-muted">Sin judicializar</span>
                    @if (!string.IsNullOrEmpty(_encabezado.Procurador))
                    {
                        <span><Icono Nombre="usuarios" Tamano="16" /> @_encabezado.Procurador</span>
                    }
                </div>
            }
        </div>
        @if (_puedeEditar && !_encabezado.Anulado)
        {
            <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="@($"/expedientes/{Id}?tab=etapas")">
                <Icono Nombre="mas" Tamano="16" Grosor="2.2" /> Registrar etapa
            </a>
        }
    </section>

    @if (_encabezado.Anulado)
    {
        <div class="alert alert-warning" role="alert">Expediente dado de baja. @_encabezado.MotivoAnulacion</div>
    }

    <nav class="pestanas" aria-label="Secciones del expediente">
        @foreach (var (clave, nombre, icono) in Pestanas)
        {
            <a class="pestana @(Pestana == clave ? "activa" : "")" href="@($"/expedientes/{Id}?tab={clave}")"
               aria-current="@(Pestana == clave ? "page" : null)">
                <Icono Nombre="@icono" Tamano="18" />@nombre
            </a>
        }
    </nav>

    @switch (Pestana)
    {
        case "personas":
            @if (_personas is null)
            {
                <p class="text-muted">Cargando…</p>
            }
            else
            {
                <PersonasExpediente ExpedienteId="Id" Puede="_puedeEditar" Personas="_personas" TiposDocumento="_tiposDocumento"
                                    AgregarNueva="AgregarPersonaAsync" VincularExistente="VincularPersonaAsync"
                                    Editar="EditarPersonaAsync" Quitar="QuitarPersonaAsync" Buscar="BuscarPersonasAsync" />
            }
            break;

        case "periodos":
            @if (_periodos is null)
            {
                <p class="text-muted">Cargando…</p>
            }
            else
            {
                <PeriodosExpediente Puede="_puedeEditar" Periodos="_periodos"
                                    Agregar="AgregarPeriodoAsync" Editar="EditarPeriodoAsync" Eliminar="EliminarPeriodoAsync" />
            }
            break;

        case "etapas":
            <EtapasExpediente ExpedienteId="Id" Cambiado="RecargarEncabezadoAsync" />
            break;

        case "tareas":
            <section class="tarjeta" aria-labelledby="titulo-tareas">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-verde"><Icono Nombre="tareas" Tamano="18" Grosor="2" /></span>
                    <h2 id="titulo-tareas">Tareas del expediente</h2>
                    <a href="/tareas" class="small fw-semibold">Ir a Tareas</a>
                </div>
                @if (_mensajeTareas is not null)
                {
                    <div class="alert @(_exitoTareas ? "alert-success" : "alert-danger") py-2" role="status">@_mensajeTareas</div>
                }
                @if (_tareas is null)
                {
                    <p class="text-muted mb-0">Cargando…</p>
                }
                else if (_tareas.Count == 0)
                {
                    <p class="text-muted mb-0">No hay tareas para este expediente.</p>
                }
                else
                {
                    <div class="tabla-contenedor">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Tarea</th><th>Vence</th><th>Responsable</th><th>Estado</th>
                                    @if (_puedeEditarTareas)
                                    {
                                        <th class="text-end">Acciones</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in PaginaDe(_tareas, _paginaTareas))
                                {
                                    <tr>
                                        <td class="principal-celda">@t.Titulo</td>
                                        <td class="numero">@(t.Vence?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(t.Responsable ?? "—")</td>
                                        <td><span class="pastilla @ColorEstadoTarea(t.Estado)">@NombreEstadoTarea(t.Estado)</span></td>
                                        @if (_puedeEditarTareas)
                                        {
                                            <td class="text-end">
                                                @if (t.Estado == EstadoTareaPendiente)
                                                {
                                                    <button class="btn btn-sm btn-outline-success text-nowrap"
                                                            @onclick="() => CumplirTareaAsync(t.Id)">Marcar cumplida</button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <Paginador Total="_tareas.Count" Pagina="_paginaTareas" Paginas="PaginasDe(_tareas.Count)" Tamanio="_tamanioFicha"
                               IrAPagina="p => _paginaTareas = p" CambiarTamanio="t => CambiarTamanioFicha(t)" />
                }
            </section>
            break;

        default:
            @if (_resumen is null)
            {
                <p class="text-muted">Cargando…</p>
            }
            else
            {
                <div class="grilla-ficha">
                    <section class="tarjeta acento" aria-labelledby="titulo-demandado">
                        <div class="cabecera-seccion">
                            <span class="icono-tono tono-azul"><Icono Nombre="usuarios" Tamano="18" Grosor="2" /></span>
                            <h2 id="titulo-demandado">Demandado</h2>
                            @if (_resumen.Codemandados > 0)
                            {
                                <span class="pastilla azul">+@_resumen.Codemandados codemandado(s)</span>
                            }
                        </div>
                        <div class="persona-principal">
                            <span class="avatar-grande" aria-hidden="true">@Iniciales(_resumen.Demandado)</span>
                            <span class="nombre">@(_resumen.Demandado ?? "Sin demandado cargado")</span>
                        </div>
                        <dl class="datos">
                            <dt>Comitente</dt><dd>@(_resumen.Comitente ?? "—")</dd>
                            <dt>Concepto</dt><dd>@(_resumen.Concepto ?? "—")</dd>
                        </dl>
                    </section>

                    @if (_tituloDeuda is not null)
                    {
                        <EditarTituloDeuda Datos="_tituloDeuda" Puede="_puedeEditar"
                                           Guardar="GuardarTituloDeudaAsync" Sincronizar="SincronizarCapitalAsync" />
                    }

                    @if (_objetoDeuda is not null)
                    {
                        <EditarObjetoDeuda Datos="_objetoDeuda" Puede="_puedeEditar" Guardar="GuardarObjetoDeudaAsync" />
                    }

                    @* Datos del juicio: si todavía no está judicializada, se puede abrir para cargarlos. *@
                    @if (_juicio is not null)
                    {
                        <EditarJuicio Datos="_juicio" Puede="_puedeEditar" Juzgados="_juzgados" Guardar="GuardarJuicioAsync" />
                    }
                    @* La comparecencia es del juicio: sin judicializar no hay dónde comparecer. *@
                    @if (_comparecencia is not null && _encabezado.Judicializado)
                    {
                        <EditarComparecencia Datos="_comparecencia" Puede="_puedeEditar" Guardar="GuardarComparecenciaAsync" />
                    }

                    @if (_profesionales is not null)
                    {
                        <EditarProfesionales Datos="_profesionales" Puede="_puedeEditar"
                                             Procuradores="_procuradores" Patrocinantes="_patrocinantes" AbogadosInterior="_abogadosInterior"
                                             Guardar="GuardarProfesionalesAsync" />
                    }

                    @if (_clasificacion is not null)
                    {
                        <EditarClasificacion Datos="_clasificacion" Puede="_puedeEditar"
                                             Regiones="_regiones" Campanias="_campanias" Guardar="GuardarClasificacionAsync" />
                    }
                    @if (_observaciones is not null)
                    {
                        <EditarObservaciones Datos="_observaciones" Puede="_puedeEditar" Guardar="GuardarObservacionesAsync" />
                    }
                </div>
            }
            break;
    }
}

@code {
    private static readonly (string Clave, string Nombre, string Icono)[] Pestanas =
    [
        ("resumen", "Resumen", "resumen"), ("personas", "Personas", "usuarios"), ("periodos", "Períodos", "calendario"),
        ("etapas", "Etapas", "linea"), ("tareas", "Tareas", "tareas")
    ];

    private static readonly System.Globalization.CultureInfo Argentina = new("es-AR");

    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private bool _visible;
    private long? _idCargado;
    private string? _pestanaCargada;
    private Procu360.Infraestructura.Expedientes.EncabezadoExpediente? _encabezado;
    private Procu360.Infraestructura.Expedientes.ResumenExpediente? _resumen;
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.VinculoPersona>? _personas;
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.PeriodoEditable>? _periodos;
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.TareaExpediente>? _tareas;
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _tiposDocumento = [];
    private Procu360.Infraestructura.Expedientes.DatosObjetoDeuda? _objetoDeuda;
    private Procu360.Infraestructura.Expedientes.DatosTituloDeuda? _tituloDeuda;
    private Procu360.Infraestructura.Expedientes.DatosComparecencia? _comparecencia;
    private Procu360.Infraestructura.Expedientes.DatosClasificacion? _clasificacion;
    private Procu360.Infraestructura.Expedientes.DatosJuicio? _juicio;
    private Procu360.Infraestructura.Expedientes.DatosObservaciones? _observaciones;
    private Procu360.Infraestructura.Expedientes.DatosProfesionales? _profesionales;
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _juzgados = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _procuradores = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _patrocinantes = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _abogadosInterior = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _regiones = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _campanias = [];
    private bool _puedeEditar;
    private bool _puedeEditarTareas;
    /// <summary>False cuando algo cambió el expediente desde otra pestaña y hay que releer el resumen.</summary>
    private bool _resumenAlDia;
    private string? _mensajeTareas;
    private bool _exitoTareas;
    private int _tamanioFicha = 25;
    private int _paginaTareas = 1;

    /// <summary>Estado 1 de dbo.Tarea: pendiente. Es la única que se puede marcar cumplida.</summary>
    private const byte EstadoTareaPendiente = 1;

    private string Pestana => Pestanas.Any(p => p.Clave == Tab) ? Tab! : "resumen";

    private int PaginasDe(int total) => Math.Max(1, (int)Math.Ceiling(total / (double)_tamanioFicha));

    private IEnumerable<T> PaginaDe<T>(IReadOnlyList<T> lista, int pagina) =>
        lista.Skip((Math.Clamp(pagina, 1, PaginasDe(lista.Count)) - 1) * _tamanioFicha).Take(_tamanioFicha);

    private void CambiarTamanioFicha(int tamanio)
    {
        _tamanioFicha = tamanio;
        _paginaTareas = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        Procu360.Infraestructura.Identidad.SesionContexto.Aplicar(estado.User, Contexto);
        _puedeEditar = await Autorizacion.TieneAsync("expedientes.editar");
        _puedeEditarTareas = await Autorizacion.TieneAsync("tareas.editar");
    }

    /// <summary>
    /// Se ejecuta también cuando cambia ?tab= sin salir de la página: Blazor reutiliza el componente y no
    /// vuelve a llamar a OnInitializedAsync, así que cada pestaña carga sus datos acá.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_idCargado != Id)
        {
            _visible = await Servicio.VisibleAsync(Id);
            _encabezado = _visible ? await Servicio.EncabezadoAsync(Id) : null;
            _idCargado = Id;
            _pestanaCargada = null;
            _paginaTareas = 1;
        }
        // El resumen se vuelve a leer si quedó viejo (por ejemplo, tras registrar una etapa en otra pestaña).
        var yaCargada = _pestanaCargada == Pestana && (Pestana != "resumen" || _resumenAlDia);
        if (!_visible || yaCargada) return;

        switch (Pestana)
        {
            case "personas": await CargarPersonasAsync(); break;
            case "periodos": _periodos = await PeriodosServicio.ListarAsync(Id); break;
            case "etapas": break; // la pestaña carga sus datos en EtapasExpediente
            case "tareas": _tareas = await Servicio.TareasAsync(Id); _mensajeTareas = null; break;
            default: await CargarResumenAsync(); break;
        }
        _pestanaCargada = Pestana;
    }

    /// <summary>Consultas en secuencia: los componentes de edición no consultan la base por su cuenta.</summary>
    private async Task CargarResumenAsync()
    {
        _resumenAlDia = true;
        _resumen = await Servicio.ResumenAsync(Id);
        _objetoDeuda = await Edicion.ObjetoDeudaAsync(Id);
        _tituloDeuda = await Edicion.TituloDeudaAsync(Id);
        _juicio = await Edicion.JuicioAsync(Id);
        _comparecencia = await Edicion.ComparecenciaAsync(Id);
        _clasificacion = await Edicion.ClasificacionAsync(Id);
        _observaciones = await Edicion.ObservacionesAsync(Id);
        _profesionales = await Edicion.ProfesionalesAsync(Id);
        if (_puedeEditar)
        {
            _juzgados = await Edicion.JuzgadosAsync();
            _procuradores = await Edicion.ProfesionalesDeRolAsync("procurador");
            _patrocinantes = await Edicion.ProfesionalesDeRolAsync("patrocinante");
            _abogadosInterior = await Edicion.ProfesionalesDeRolAsync("abogadoInterior");
            _regiones = await Edicion.RegionesAsync();
            _campanias = await Edicion.CampaniasAsync();
        }
    }

    // ------------------------------------------------------------- personas

    private async Task CargarPersonasAsync()
    {
        _personas = await PersonasServicio.ListarAsync(Id);
        if (_puedeEditar && _tiposDocumento.Count == 0)
            _tiposDocumento = await PersonasServicio.TiposDocumentoAsync();
    }

    private Task<IReadOnlyList<Procu360.Infraestructura.Expedientes.PersonaEncontrada>> BuscarPersonasAsync(string texto) =>
        PersonasServicio.BuscarAsync(Id, texto);

    private async Task<string?> AgregarPersonaAsync(Procu360.Infraestructura.Expedientes.DatosPersona datos)
    {
        var r = await PersonasServicio.AgregarNuevaAsync(Id, datos);
        if (!r.Exito) return r.Error;
        await RecargarPersonasAsync();
        return null;
    }

    private async Task<string?> VincularPersonaAsync(long personaId, byte rol)
    {
        var r = await PersonasServicio.VincularExistenteAsync(Id, personaId, rol);
        if (!r.Exito) return r.Error;
        await RecargarPersonasAsync();
        return null;
    }

    private async Task<string?> EditarPersonaAsync(long vinculoId,
        Procu360.Infraestructura.Expedientes.DatosPersona datos, byte[] versionPersona)
    {
        var r = await PersonasServicio.EditarAsync(Id, vinculoId, datos, versionPersona);
        if (!r.Exito) return r.Error;
        await RecargarPersonasAsync();
        return null;
    }

    private async Task<string?> QuitarPersonaAsync(long vinculoId)
    {
        var r = await PersonasServicio.QuitarAsync(Id, vinculoId);
        if (!r.Exito) return r.Error;
        await RecargarPersonasAsync();
        return null;
    }

    /// <summary>El encabezado muestra el demandado y los codemandados, así que también se rehace.</summary>
    private async Task RecargarPersonasAsync()
    {
        _personas = await PersonasServicio.ListarAsync(Id);
        _encabezado = await Servicio.EncabezadoAsync(Id);
        StateHasChanged();
    }

    // ------------------------------------------------------------- etapas

    /// <summary>
    /// Registrar una etapa cambia la etapa actual y, en el flujo principal, la instancia del expediente:
    /// las dos se muestran en el encabezado, así que hay que volver a leerlo.
    /// </summary>
    private async Task RecargarEncabezadoAsync()
    {
        _encabezado = await Servicio.EncabezadoAsync(Id);
        // El resumen que haya quedado en memoria es viejo: se vuelve a leer al entrar a esa pestaña.
        _resumenAlDia = false;
        StateHasChanged();
    }

    // ------------------------------------------------------------- tareas

    /// <summary>Marca la tarea como cumplida sin salir de la ficha. El servicio valida permiso y alcance.</summary>
    private async Task CumplirTareaAsync(long tareaId)
    {
        var r = await TareasServicio.CumplirAsync(tareaId);
        _exitoTareas = r.Exito;
        _mensajeTareas = r.Exito ? "Tarea marcada como cumplida." : r.Error;
        if (r.Exito) _tareas = await Servicio.TareasAsync(Id);
    }

    // ------------------------------------------------------------- períodos

    private async Task<string?> AgregarPeriodoAsync(Procu360.Infraestructura.Expedientes.DatosPeriodo datos)
    {
        var r = await PeriodosServicio.AgregarAsync(Id, datos);
        if (!r.Exito) return r.Error;
        await RecargarPeriodosAsync();
        return null;
    }

    private async Task<string?> EditarPeriodoAsync(long periodoId,
        Procu360.Infraestructura.Expedientes.DatosPeriodo datos, byte[] version)
    {
        var r = await PeriodosServicio.EditarAsync(Id, periodoId, datos, version);
        if (!r.Exito) return r.Error;
        await RecargarPeriodosAsync();
        return null;
    }

    private async Task<string?> EliminarPeriodoAsync(long periodoId)
    {
        var r = await PeriodosServicio.EliminarAsync(Id, periodoId);
        if (!r.Exito) return r.Error;
        await RecargarPeriodosAsync();
        return null;
    }

    /// <summary>El capital del título sigue a los períodos, así que se vuelve a leer con ellos.</summary>
    private async Task RecargarPeriodosAsync()
    {
        _periodos = await PeriodosServicio.ListarAsync(Id);
        _tituloDeuda = await Edicion.TituloDeudaAsync(Id);
        StateHasChanged();
    }

    // ------------------------------------------------------------- secciones del resumen

    private async Task<string?> GuardarObjetoDeudaAsync(Procu360.Infraestructura.Expedientes.DatosObjetoDeuda datos)
    {
        var r = await Edicion.GuardarObjetoDeudaAsync(Id, datos);
        if (!r.Exito) return r.Error;
        await RecargarAsync();
        return null;
    }

    private async Task<string?> GuardarTituloDeudaAsync(Procu360.Infraestructura.Expedientes.DatosTituloDeuda datos)
    {
        var r = await Edicion.GuardarTituloDeudaAsync(Id, datos);
        if (!r.Exito) return r.Error;
        await RecargarAsync();
        return null;
    }

    /// <summary>Iguala el capital a la suma de períodos, aunque antes se haya editado a mano.</summary>
    private async Task<string?> SincronizarCapitalAsync()
    {
        var r = await Edicion.SincronizarCapitalAsync(Id, forzar: true);
        if (!r.Exito) return r.Error;
        await RecargarAsync();
        return null;
    }

    private async Task<string?> GuardarComparecenciaAsync(Procu360.Infraestructura.Expedientes.DatosComparecencia datos)
    {
        var r = await Edicion.GuardarComparecenciaAsync(Id, datos);
        if (!r.Exito) return r.Error;
        await RecargarAsync();
        return null;
    }

