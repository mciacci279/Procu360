@rendermode InteractiveServer
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject Procu360.Infraestructura.Etapas.ServicioEtapas Etapas
@inject ServicioPermisos Autorizacion

@* Todas las consultas de este componente van en secuencia (OnInitializedAsync y los manejadores de eventos);
   el hijo RegistrarEtapa no consulta la base. Así no se usa el DbContext en paralelo. *@

<RegistrarEtapa ExpedienteId="ExpedienteId" Puede="_puedeEditar" Catalogo="_catalogo" Registrado="RecargarAsync" />

@if (_mensaje is not null)
{
    <div class="alert @(_exito ? "alert-success" : "alert-danger") py-2" role="status">@_mensaje</div>
}

<section class="tarjeta" aria-labelledby="titulo-linea">
    <div class="cabecera-linea">
        <div class="cabecera-seccion mb-0">
            <span class="icono-tono tono-ambar"><Icono Nombre="linea" Tamano="18" Grosor="2" /></span>
            <h2 id="titulo-linea">Línea de tiempo</h2>
        </div>
        <ul class="referencias" aria-label="Referencias">
            <li><span class="muestra actual" aria-hidden="true"></span>Etapa actual</li>
            <li><span class="muestra cumplida" aria-hidden="true"></span>Cumplimentada</li>
            <li><span class="muestra abierta" aria-hidden="true"></span>Abierta</li>
            <li><span class="muestra suspendida" aria-hidden="true"></span>Suspendida</li>
        </ul>
    </div>

    @if (_filas is null)
    {
        <div aria-busy="true" aria-label="Cargando la línea de tiempo de etapas">
            <Esqueleto Tipo="Esqueleto.TipoEsqueleto.Lista" Filas="4" />
        </div>
    }
    else if (_filas.Count == 0)
    {
        <p class="text-muted mb-0">Todavía no hay etapas registradas.</p>
    }
    else
    {
        <ol class="linea-tiempo">
            @foreach (var e in _filas)
            {
                <li class="hito @ClaseEstado(e)">
                    <span class="tl-punto" aria-hidden="true"></span>
                    <div class="tl-contenido">
                        <div class="tl-titulo">
                            <span class="tl-fecha">@e.Inicio.ToString("dd/MM/yyyy")</span>
                            <strong>@e.Nombre</strong>
                            @if (e.EsActual) { <span class="pastilla tl-etiqueta-actual">Etapa actual</span> }
                            @if (e.EsDiligencia) { <span class="pastilla cian">Diligencia</span> }
                            @if (e.Flujo == 2) { <span class="pastilla gris">Cautelar</span> }
                        </div>
                        <div class="tl-detalle">
                            @if (e.Vencimiento is DateOnly v) { <span>Vence @v.ToString("dd/MM/yyyy")</span><span aria-hidden="true">·</span> }
                            <span>@NombreEstado(e.Estado)</span>
                            @if (e.Monto is decimal m) { <span aria-hidden="true">·</span><span class="numero">@m.ToString("C2", Argentina)</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(e.Observaciones)) { <div class="tl-observaciones">@e.Observaciones</div> }
                        @if (_puedeEditar && e.Estado == 1)
                        {
                            <div class="tl-acciones">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarAsync(e.Id, 2)">Cumplimentar</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarAsync(e.Id, 3)">Suspender</button>
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired] public long ExpedienteId { get; set; }

    /// <summary>
    /// Avisa al padre que cambió el estado del expediente: registrar una etapa mueve la etapa actual y,
    /// en el flujo principal, también la instancia, y eso se ve en el encabezado de la ficha.
    /// </summary>
    [Parameter] public EventCallback Cambiado { get; set; }

    private static readonly System.Globalization.CultureInfo Argentina = new("es-AR");
    private bool _puedeEditar;
    private bool _exito;
    private string? _mensaje;
    private IReadOnlyList<(int Id, string Nombre, byte Flujo)> _catalogo = [];
    private IReadOnlyList<Procu360.Infraestructura.Etapas.FilaEtapa>? _filas;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        Procu360.Infraestructura.Identidad.SesionContexto.Aplicar(estado.User, Contexto);
        _puedeEditar = await Autorizacion.TieneAsync("expedientes.editar");
    }

    /// <summary>La línea de tiempo se carga tras el primer dibujado, con el esqueleto a la vista.</summary>
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender || _filas is not null) return;
        _catalogo = _puedeEditar ? await Etapas.CatalogoAsync() : [];
        await CargarAsync();
        StateHasChanged();
    }

    private async Task CargarAsync() => _filas = await Etapas.ListarAsync(ExpedienteId);

    private async Task RecargarAsync()
    {
        Autorizacion.Invalidar();
        _mensaje = "Etapa registrada.";
        _exito = true;
        await CargarAsync();
        await Cambiado.InvokeAsync();
    }

    private async Task CambiarAsync(long etapaExpedienteId, byte nuevoEstado)
    {
        var r = await Etapas.CambiarEstadoAsync(etapaExpedienteId, nuevoEstado);
        _exito = r.Exito;
        _mensaje = r.Exito ? "Estado de la etapa actualizado." : r.Error;
        await CargarAsync();
        if (r.Exito) await Cambiado.InvokeAsync();
    }

    private static string ClaseEstado(Procu360.Infraestructura.Etapas.FilaEtapa e) =>
        e.EsActual ? "tl-actual" : e.Estado switch { 2 => "tl-cumplida", 3 => "tl-suspendida", _ => "tl-abierta" };

    private static string NombreEstado(byte estado) => estado switch
    {
        1 => "Alta", 2 => "Cumplimentada", 3 => "Suspendida", 4 => "Baja", _ => "—"
    };
}
