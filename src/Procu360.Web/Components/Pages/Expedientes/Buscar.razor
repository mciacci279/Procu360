@page "/expedientes"
@attribute [Authorize(Policy = "expedientes.consultar")]
@inject Procu360.Infraestructura.Expedientes.ServicioBusquedaExpedientes Busqueda

<PageTitle>Expedientes · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Expedientes</h1>
        <p class="bajada">Buscá por cualquier dato del expediente y combiná filtros.</p>
    </div>
</div>

<form method="get" action="/expedientes" class="tarjeta panel-filtros" role="search">
    <div class="buscador">
        <div class="campo">
            <label for="q" class="visually-hidden">Buscar expediente</label>
            <Icono Nombre="buscar" Tamano="18" Grosor="2" />
            <input id="q" name="q" value="@Q" autofocus autocomplete="off"
                   placeholder="Nro de orden, expediente judicial, DNI/CUIT, liquidación, cuenta, dominio o carátula" />
        </div>
        <button class="btn btn-primary" type="submit">Buscar</button>
        @if (HayCriterio)
        {
            <a class="btn btn-outline-secondary d-inline-flex align-items-center" style="height: 50px; border-radius: 14px" href="/expedientes">Limpiar</a>
        }
    </div>
    <p class="ayuda-filtros">Un solo campo: "641" encuentra "00641".</p>

    <div class="filtros">
        <span class="rotulo-filtros"><Icono Nombre="filtro" Tamano="15" Grosor="2" /> Filtros</span>
        <label class="chip-select">
            <span>Comitente:</span>
            <select name="comitente">
                <option value="">Todos</option>
                @foreach (var c in _comitentes)
                {
                    <option value="@c.Id" selected="@(Comitente == c.Id)">@c.Nombre</option>
                }
            </select>
        </label>
        <label class="chip-select">
            <span>Instancia:</span>
            <select name="instancia">
                <option value="">Todas</option>
                @foreach (var i in _instancias)
                {
                    <option value="@i.Id" selected="@(Instancia == i.Id)">@i.Nombre</option>
                }
            </select>
        </label>
        <label class="chip-toggle">
            <input type="checkbox" name="sinMov" value="true" checked="@(SinMov == true)" />
            <span>Sin movimiento</span>
        </label>
        <label class="chip-toggle">
            <input type="checkbox" name="bajas" value="true" checked="@(Bajas == true)" />
            <span>Incluir dados de baja</span>
        </label>
    </div>
</form>

@if (_resultado is null)
{
    <div class="tarjeta text-center py-5">
        <span class="icono-tono tono-azul mb-3" style="width: 52px; height: 52px; border-radius: 16px"><Icono Nombre="buscar" Tamano="24" Grosor="2" /></span>
        <p class="mb-0 fw-semibold">Escribí algo o elegí un filtro para ver expedientes.</p>
    </div>
}
else if (_resultado.Total == 0)
{
    <div class="alert alert-secondary" role="status">No hay expedientes que coincidan con la búsqueda en tu alcance.</div>
}
else
{
    <div class="resumen-resultados">
        <span><strong>@_resultado.Total</strong> expedientes encontrados</span>
        <span>Página @_resultado.Pagina de @_resultado.Paginas</span>
    </div>

    <div class="tabla-contenedor">
        <table class="table">
            <thead>
                <tr>
                    <th>Nro orden</th>
                    <th>Carátula</th>
                    <th>Concepto</th>
                    <th>Instancia</th>
                    <th>Última etapa</th>
                    <th>Último movimiento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _resultado.Filas)
                {
                    <tr class="@(f.Anulado ? "text-muted" : "")">
                        <td>
                            <a class="nro" href="/expedientes/@f.Id">@f.NroOrden.ToString("D5")</a>
                            @if (f.NroExpedienteJudicial is not null)
                            {
                                <span class="secundario">Judicial @f.NroExpedienteJudicial</span>
                            }
                        </td>
                        <td>
                            <span class="principal-celda">@(f.Caratula ?? "—")</span>
                            @if (f.Demandado is not null)
                            {
                                <span class="secundario">@f.Demandado</span>
                            }
                        </td>
                        <td>@(f.Concepto ?? "—")</td>
                        <td>
                            @if (f.Anulado)
                            {
                                <span class="pastilla roja">Dado de baja</span>
                            }
                            else if (f.Instancia is not null)
                            {
                                <span class="pastilla azul">@f.Instancia</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@(f.UltimaEtapa ?? "—")</td>
                        <td class="numero">@(f.FechaUltimoMovimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_resultado.Paginas > 1)
    {
        <nav aria-label="Paginación">
            <ul class="pagination">
                @if (_resultado.Pagina > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Enlace(_resultado.Pagina - 1)">← Anterior</a></li>
                }
                <li class="page-item disabled"><span class="page-link">Página @_resultado.Pagina de @_resultado.Paginas</span></li>
                @if (_resultado.Pagina < _resultado.Paginas)
                {
                    <li class="page-item"><a class="page-link" href="@Enlace(_resultado.Pagina + 1)">Siguiente →</a></li>
                }
            </ul>
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "comitente")] public int? Comitente { get; set; }
    [SupplyParameterFromQuery(Name = "instancia")] public int? Instancia { get; set; }
    [SupplyParameterFromQuery(Name = "sinMov")] public bool? SinMov { get; set; }
    [SupplyParameterFromQuery(Name = "bajas")] public bool? Bajas { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? Pagina { get; set; }

    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _comitentes = [];
    private IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> _instancias = [];
    private Procu360.Infraestructura.Expedientes.ResultadoBusqueda? _resultado;

    private bool HayCriterio => !string.IsNullOrWhiteSpace(Q) || Comitente is not null || Instancia is not null
        || SinMov == true || Bajas == true;

    protected override async Task OnInitializedAsync()
    {
        _comitentes = await Busqueda.ComitentesAsync();
        _instancias = await Busqueda.InstanciasAsync();

        if (!HayCriterio) return;

        _resultado = await Busqueda.BuscarAsync(new Procu360.Infraestructura.Expedientes.CriteriosBusqueda(
            Texto: Q,
            ComitenteId: Comitente,
            InstanciaId: Instancia,
            SinMovimiento: SinMov == true,
            IncluirDadosDeBaja: Bajas == true,
            Pagina: Pagina ?? 1));
    }

    private string Enlace(int pagina)
    {
        var partes = new List<string> { $"pagina={pagina}" };
        if (!string.IsNullOrWhiteSpace(Q)) partes.Add($"q={Uri.EscapeDataString(Q)}");
        if (Comitente is int c) partes.Add($"comitente={c}");
        if (Instancia is int i) partes.Add($"instancia={i}");
        if (SinMov == true) partes.Add("sinMov=true");
        if (Bajas == true) partes.Add("bajas=true");
        return "/expedientes?" + string.Join("&", partes);
    }
}
