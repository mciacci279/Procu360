<section class="tarjeta">
    <div class="cabecera-seccion">
        <span class="icono-tono tono-ambar"><Icono Nombre="balanza" Tamano="18" Grosor="2" /></span>
        <h2>Datos del juicio</h2>
        @if (Puede && !_editando)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="Empezar">Editar</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger py-2" role="alert">@_error</div>
    }

    @if (!_editando)
    {
        <dl class="datos">
            <dt>Juzgado</dt><dd>@(NombreJuzgado(Datos.JuzgadoId) ?? "—")</dd>
            <dt>Nro. expediente judicial</dt><dd>@(Datos.NroExpedienteJudicial ?? "—")</dd>
            <dt>Carátula</dt><dd>@(Datos.Caratula ?? "—")</dd>
            <dt>Recaratulación</dt><dd>@(Datos.Recaratulacion ?? "—")</dd>
            <dt>Sorteo</dt><dd>@(Datos.Sorteo ?? "—")</dd>
            <dt>Fecha de sorteo</dt><dd>@(Datos.FechaSorteo?.ToString("dd/MM/yyyy") ?? "—")</dd>
        </dl>
    }
    else
    {
        <div class="row g-2">
            <div class="col-12">
                <label class="form-label small" for="juzgado">Juzgado</label>
                <select id="juzgado" class="form-select form-select-sm" @bind="_juzgadoId">
                    <option value="0">Sin juzgado</option>
                    @foreach (var j in Juzgados)
                    {
                        <option value="@j.Id">@j.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label small" for="nroJudicial">Nro. expediente judicial</label>
                <input id="nroJudicial" class="form-control form-control-sm" maxlength="50" @bind="_nroJudicial" />
            </div>
            <div class="col-12">
                <label class="form-label small" for="caratula">Carátula</label>
                <input id="caratula" class="form-control form-control-sm" maxlength="400" @bind="_caratula" />
            </div>
            <div class="col-12">
                <label class="form-label small" for="recaratulacion">Recaratulación</label>
                <input id="recaratulacion" class="form-control form-control-sm" maxlength="400" @bind="_recaratulacion" />
            </div>
            <div class="col-md-6">
                <label class="form-label small" for="sorteo">Sorteo</label>
                <input id="sorteo" class="form-control form-control-sm" maxlength="50" @bind="_sorteo" />
            </div>
            <div class="col-md-6">
                <label class="form-label small" for="fechaSorteo">Fecha de sorteo</label>
                <input id="fechaSorteo" class="form-control form-control-sm" type="date" @bind="_fechaSorteo" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button class="btn btn-sm btn-primary" @onclick="GuardarAsync">Guardar</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Procu360.Infraestructura.Expedientes.DatosJuicio Datos { get; set; } = null!;
    [Parameter] public bool Puede { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<Procu360.Infraestructura.Expedientes.OpcionCatalogo> Juzgados { get; set; } = [];
    /// <summary>Guarda la sección. Devuelve el error a mostrar, o null si se guardó.</summary>
    [Parameter, EditorRequired] public Func<Procu360.Infraestructura.Expedientes.DatosJuicio, Task<string?>> Guardar { get; set; } = null!;

    private bool _editando;
    private string? _error;
    private int _juzgadoId;
    private string? _nroJudicial, _caratula, _recaratulacion, _sorteo;
    private DateOnly? _fechaSorteo;

    private string? NombreJuzgado(int? id) => Juzgados.FirstOrDefault(j => j.Id == id)?.Nombre;

    private void Empezar()
    {
        _juzgadoId = Datos.JuzgadoId ?? 0;
        _nroJudicial = Datos.NroExpedienteJudicial;
        _caratula = Datos.Caratula;
        _recaratulacion = Datos.Recaratulacion;
        _sorteo = Datos.Sorteo;
        _fechaSorteo = Datos.FechaSorteo;
        _error = null;
        _editando = true;
    }

    private void Cancelar() { _editando = false; _error = null; }

    private async Task GuardarAsync()
    {
        var nuevo = new Procu360.Infraestructura.Expedientes.DatosJuicio(
            _juzgadoId == 0 ? null : _juzgadoId, _nroJudicial, _caratula, _recaratulacion, _sorteo, _fechaSorteo, Datos.Version);
        _error = await Guardar(nuevo);
        if (_error is null) _editando = false;
    }
}
