@page "/estudio/invitaciones"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject ServicioInvitaciones Servicio
@inject ServicioPermisos Autorizacion
@inject ServicioAdministracionEstudio Administracion
@inject NavigationManager Navegacion

<PageTitle>Invitaciones · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Invitaciones</h1>
        <p class="bajada">Sumá integrantes al Estudio con un enlace de un solo uso.</p>
    </div>
    <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="/estudio/usuarios">
        <Icono Nombre="usuarios" Tamano="16" Grosor="2" /> Ver usuarios
    </a>
</div>

@if (!_cargado)
{
    <div class="tarjeta" aria-busy="true" aria-label="Cargando las invitaciones">
        <Esqueleto Tipo="Esqueleto.TipoEsqueleto.Lista" Filas="4" />
    </div>
}
else if (!_puedeAdministrar)
{
    <div class="alert alert-warning" role="alert">No tenés permiso para administrar usuarios y roles de este Estudio.</div>
}
else
{
    @if (_mensaje is not null)
    {
        <div class="alert @(_exito ? "alert-success" : "alert-danger")" role="status">@_mensaje</div>
    }

    <div class="columnas">
        <div class="principal">
            <section class="tarjeta" aria-labelledby="titulo-pendientes">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-ambar"><Icono Nombre="reloj" Tamano="18" Grosor="2" /></span>
                    <h2 id="titulo-pendientes">Invitaciones sin aceptar</h2>
                </div>
                @if (Pendientes.Count == 0)
                {
                    <p class="text-muted mb-0">No hay invitaciones pendientes. Las que crees van a aparecer acá hasta que la persona active su cuenta.</p>
                }
                else
                {
                    <div class="tabla-contenedor">
                        <table class="table">
                            <thead><tr><th>Persona</th><th>Estado</th></tr></thead>
                            <tbody>
                                @foreach (var m in FilasPagina)
                                {
                                    <tr>
                                        <td>
                                            <span class="principal-celda">@m.NombreCompleto</span>
                                            <span class="secundario">@m.Email</span>
                                        </td>
                                        <td>
                                            <span class="pastilla @(m.Estado == 1 ? "cian" : "ambar")">
                                                @(m.Estado == 1 ? "Invitado · falta aceptar" : "Pendiente de aprobación")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <Paginador Total="Pendientes.Count" Pagina="_pagina" Paginas="Paginas" Tamanio="_tamanio"
                               IrAPagina="p => _pagina = p" CambiarTamanio="CambiarTamanio" />
                }
            </section>
        </div>

        <div class="lateral">
            <section class="tarjeta panel-accion" aria-labelledby="titulo-invitar">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-azul"><Icono Nombre="mas" Tamano="18" Grosor="2.2" /></span>
                    <h2 id="titulo-invitar">Invitar integrante</h2>
                </div>
                <EditForm Model="_modelo" OnValidSubmit="InvitarAsync" FormName="invitar">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <InputText id="email" class="form-control" @bind-Value="_modelo.Email" />
                        <ValidationMessage For="() => _modelo.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="nombre">Nombre</label>
                        <InputText id="nombre" class="form-control" @bind-Value="_modelo.Nombre" />
                        <ValidationMessage For="() => _modelo.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="apellido">Apellido</label>
                        <InputText id="apellido" class="form-control" @bind-Value="_modelo.Apellido" />
                        <ValidationMessage For="() => _modelo.Apellido" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit" disabled="@_enviando">Crear invitación</button>
                </EditForm>

                @if (_enlace is not null)
                {
                    <div class="mt-3 pt-3" style="border-top: 1px solid #DBEAFE">
                        <div class="form-label">Enlace de invitación (válido 7 días, de un solo uso)</div>
                        <input class="form-control" readonly value="@_enlace" onclick="this.select()" />
                        <p class="form-text mb-0">Desarrollo: el enlace se muestra acá porque todavía no hay envío de email. Abrilo en una ventana de incógnito.</p>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    private readonly ModeloInvitacion _modelo = new();
    private bool _cargado;
    private bool _puedeAdministrar;
    private IReadOnlyList<VistaMembresia> _membresias = [];
    private string? _mensaje;
    private string? _enlace;
    private bool _exito;
    private bool _enviando;
    private int _pagina = 1;
    private int _tamanio = 25;

    private IReadOnlyList<VistaMembresia> Pendientes => _membresias.Where(m => m.Estado is 1 or 2).ToList();

    private int Paginas => Math.Max(1, (int)Math.Ceiling(Pendientes.Count / (double)_tamanio));

    private IEnumerable<VistaMembresia> FilasPagina =>
        Pendientes.Skip((Math.Clamp(_pagina, 1, Paginas) - 1) * _tamanio).Take(_tamanio);

    private void CambiarTamanio(int tamanio)
    {
        _tamanio = tamanio;
        _pagina = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        SesionContexto.Aplicar(estado.User, Contexto);
        _puedeAdministrar = await Autorizacion.TieneAsync(Procu360.Dominio.Seguridad.Permisos.UsuariosAdministrar);
        if (!_puedeAdministrar) _cargado = true;
    }

    /// <summary>
    /// Los datos se piden después del primer dibujado: así la pantalla aparece enseguida con su
    /// esqueleto, en vez de quedar en blanco mientras llega la consulta.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender || !_puedeAdministrar || _cargado) return;
        await CargarAsync();
        _cargado = true;
        StateHasChanged();
    }

    private async Task CargarAsync() => _membresias = await Administracion.ListarMembresiasAsync();

    private async Task InvitarAsync()
    {
        _enviando = true;
        _enlace = null;
        try
        {
            var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
            if (!SesionContexto.Aplicar(estado.User, Contexto) || SesionContexto.EstudioId(estado.User) is null)
            {
                _exito = false;
                _mensaje = "No hay un Estudio activo en tu sesión.";
                return;
            }

            var adminId = SesionContexto.UsuarioId(estado.User)!.Value;
            var resultado = await Servicio.InvitarAsync(
                adminId, new DatosInvitacion(_modelo.Email, _modelo.Nombre, _modelo.Apellido));

            switch (resultado.Tipo)
            {
                case TipoResultadoInvitacion.Creada:
                    _exito = true;
                    _mensaje = "Invitación creada.";
                    var baseUrl = Navegacion.BaseUri.TrimEnd('/');
                    _enlace = $"{baseUrl}/cuenta/invitacion?u={resultado.UsuarioId}&t={Uri.EscapeDataString(resultado.Token!)}";
                    await CargarAsync();
                    break;
                case TipoResultadoInvitacion.Pendiente:
                    _exito = true;
                    _mensaje = "Invitación registrada. Queda pendiente de aprobación de la plataforma.";
                    await CargarAsync();
                    break;
                default:
                    _exito = false;
                    _mensaje = resultado.Error ?? "No se pudo crear la invitación.";
                    break;
            }
        }
        finally
        {
            _enviando = false;
        }
    }

    public sealed class ModeloInvitacion
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresá el email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "El email no es válido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresá el nombre.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresá el apellido.")]
        public string Apellido { get; set; } = string.Empty;
    }
}
