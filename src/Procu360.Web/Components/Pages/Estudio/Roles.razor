@page "/estudio/roles"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject ServicioPermisos Autorizacion
@inject ServicioAdministracionEstudio Administracion

<PageTitle>Roles y permisos · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Roles y permisos</h1>
        <p class="bajada">Qué puede hacer cada rol, módulo por módulo.</p>
    </div>
    <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="/estudio/usuarios">
        <Icono Nombre="usuarios" Tamano="16" Grosor="2" /> Ver usuarios
    </a>
</div>

@if (!_cargado)
{
    <div class="tarjeta" aria-busy="true" aria-label="Cargando los roles y permisos">
        <Esqueleto Tipo="Esqueleto.TipoEsqueleto.Tabla" Filas="6" Columnas="4" />
    </div>
}
else if (!_puedeAdministrar)
{
    <div class="alert alert-warning" role="alert">No tenés permiso para administrar usuarios y roles de este Estudio.</div>
}
else
{
    @if (_mensaje is not null)
    {
        <div class="alert @(_exito ? "alert-success" : "alert-danger")" role="status">@_mensaje</div>
    }

    <div class="columnas">
        <div class="principal">
            <section class="tarjeta" aria-labelledby="titulo-matriz">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-azul"><Icono Nombre="escudo" Tamano="18" Grosor="2" /></span>
                    <h2 id="titulo-matriz">Permisos @(_seleccion == 0 ? "del rol nuevo" : $"de {NombreRolActual}")</h2>
                    <span class="pastilla azul">@_permisos.Count seleccionados</span>
                </div>
                <div class="tabla-contenedor">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Módulo</th>
                                @foreach (var a in Acciones.Todas)
                                {
                                    <th class="text-center text-capitalize">@a</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var modulo in Modulos.Todos)
                            {
                                <tr>
                                    <td class="principal-celda">@modulo</td>
                                    @foreach (var a in Acciones.Todas)
                                    {
                                        var permiso = Permisos.De(modulo, a);
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input" title="@permiso"
                                                   checked="@_permisos.Contains(permiso)"
                                                   @onchange="e => Alternar(permiso, (bool)(e.Value ?? false))" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="lateral">
            <section class="tarjeta panel-accion" aria-labelledby="titulo-rol">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-azul"><Icono Nombre="roles" Tamano="18" Grosor="2" /></span>
                    <h2 id="titulo-rol">Rol</h2>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rol">Rol a editar</label>
                    <select id="rol" class="form-select" @onchange="SeleccionarAsync">
                        <option value="0" selected="@(_seleccion == 0)">+ Nuevo rol personalizado</option>
                        @foreach (var r in _roles)
                        {
                            <option value="@r.Id" selected="@(_seleccion == r.Id)">@r.Nombre@(r.EsSistema ? " (sugerido)" : "")</option>
                        }
                    </select>
                </div>
                @if (_seleccion == 0)
                {
                    <div class="mb-3">
                        <label class="form-label" for="nombre">Nombre</label>
                        <input id="nombre" class="form-control" @bind="_nombre" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ambito">Alcance de expedientes</label>
                        <select id="ambito" class="form-select" @bind="_ambito">
                            <option value="1">Todo el Estudio</option>
                            <option value="2">Por comitente</option>
                            <option value="3">Expedientes asignados</option>
                        </select>
                        <p class="form-text mb-0">@DescripcionAmbito(_ambito)</p>
                    </div>
                }
                else
                {
                    <dl class="datos mb-3">
                        <dt>Alcance</dt><dd>@NombreAmbito(_ambitoActual)</dd>
                        <dt>Miembros activos</dt><dd>@_miembrosActual</dd>
                    </dl>
                }
                <button class="btn btn-primary w-100" @onclick="GuardarAsync">@(_seleccion == 0 ? "Crear rol" : "Guardar permisos")</button>
            </section>
        </div>
    </div>
}

@code {
    private bool _cargado;
    private bool _puedeAdministrar;
    private IReadOnlyList<VistaRol> _roles = [];
    private int _seleccion;
    private string _nombre = string.Empty;
    private byte _ambito = 1;
    private byte _ambitoActual = 1;
    private int _miembrosActual;
    private readonly HashSet<string> _permisos = new(StringComparer.Ordinal);
    private string? _mensaje;
    private bool _exito;

    private string NombreRolActual => _roles.FirstOrDefault(r => r.Id == _seleccion)?.Nombre ?? "—";

    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        SesionContexto.Aplicar(estado.User, Contexto);
        _puedeAdministrar = await Autorizacion.TieneAsync(Permisos.UsuariosAdministrar);
        if (!_puedeAdministrar) _cargado = true;
    }

    /// <summary>
    /// Los datos se piden después del primer dibujado: así la pantalla aparece enseguida con su
    /// esqueleto, en vez de quedar en blanco mientras llega la consulta.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender || !_puedeAdministrar || _cargado) return;
        await CargarRolesAsync();
        _cargado = true;
        StateHasChanged();
    }

    private async Task CargarRolesAsync() => _roles = await Administracion.ListarRolesAsync();

    private async Task SeleccionarAsync(ChangeEventArgs e)
    {
        _seleccion = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _permisos.Clear();
        if (_seleccion == 0) return;

        var rol = _roles.FirstOrDefault(r => r.Id == _seleccion);
        if (rol is null) return;
        foreach (var p in rol.Permisos) _permisos.Add(p);
        _ambitoActual = rol.Ambito;
        _miembrosActual = rol.Miembros;
    }

    private void Alternar(string permiso, bool marcado)
    {
        if (marcado) _permisos.Add(permiso);
        else _permisos.Remove(permiso);
    }

    private async Task GuardarAsync()
    {
        if (_seleccion == 0)
        {
            var creado = await Administracion.CrearRolAsync(_nombre, null, _ambito, _permisos.ToList());
            Informar(creado.Exito, creado.Exito ? "Rol creado." : creado.Error);
            if (creado.Exito) { Autorizacion.Invalidar(); _nombre = string.Empty; await CargarRolesAsync(); }
            return;
        }

        var actualizado = await Administracion.ActualizarPermisosAsync(_seleccion, _permisos.ToList());
        Informar(actualizado.Exito, actualizado.Exito ? "Permisos guardados." : actualizado.Error);
        if (actualizado.Exito) { Autorizacion.Invalidar(); await CargarRolesAsync(); }
    }

    private void Informar(bool exito, string? texto)
    {
        _exito = exito;
        _mensaje = texto;
    }

    private static string NombreAmbito(byte ambito) => ambito switch
    {
        1 => "Todo el Estudio",
        2 => "Por comitente",
        3 => "Expedientes asignados",
        _ => "Desconocido"
    };

    private static string DescripcionAmbito(byte ambito) => ambito switch
    {
        2 => "Al asignar este rol vas a elegir el comitente cuyos expedientes puede ver la persona.",
        3 => "La persona va a ver solo los expedientes que tenga asignados.",
        _ => "La persona va a ver todos los expedientes del Estudio.",
    };
}
