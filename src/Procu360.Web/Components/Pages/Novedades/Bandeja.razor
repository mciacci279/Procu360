@page "/novedades"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "novedades.consultar")]
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject Procu360.Infraestructura.Novedades.ServicioNovedades Novedades
@inject Procu360.Infraestructura.Expedientes.ServicioBusquedaExpedientes Busqueda

<PageTitle>Novedades · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Novedades judiciales</h1>
        <p class="bajada">Revisalas, vinculalas a su expediente y convertilas en tareas.</p>
    </div>
</div>

<nav class="pestanas" aria-label="Bandejas de novedades">
    <a class="pestana @(_pestana == "sin-revisar" ? "activa" : "")" href="/novedades?p=sin-revisar"
       aria-current="@(_pestana == "sin-revisar" ? "page" : null)"><Icono Nombre="novedades" Tamano="18" />Sin revisar</a>
    <a class="pestana @(_pestana == "revisadas" ? "activa" : "")" href="/novedades?p=revisadas"
       aria-current="@(_pestana == "revisadas" ? "page" : null)"><Icono Nombre="tareas" Tamano="18" />Revisadas</a>
    <a class="pestana @(_pestana == "sin-vincular" ? "activa" : "")" href="/novedades?p=sin-vincular"
       aria-current="@(_pestana == "sin-vincular" ? "page" : null)"><Icono Nombre="expedientes" Tamano="18" />Sin vincular</a>
</nav>

@if (_mensaje is not null)
{
    <div class="alert @(_exito ? "alert-success" : "alert-danger")" role="status">@_mensaje</div>
}

@if (_resultado is null)
{
    <p class="text-muted">Cargando…</p>
}
else if (_resultado.Total == 0)
{
    <div class="tarjeta text-center py-5">
        <span class="icono-tono tono-azul mb-3" style="width: 52px; height: 52px; border-radius: 16px"><Icono Nombre="novedades" Tamano="24" Grosor="2" /></span>
        <p class="mb-0 fw-semibold">No hay novedades en esta bandeja.</p>
    </div>
}
else
{
    <div class="resumen-resultados">
        <span><strong>@_resultado.Total</strong> novedades</span>
        <span>Página @_resultado.Pagina de @_resultado.Paginas</span>
    </div>
    <div class="tabla-contenedor">
        <table class="table">
            <thead><tr><th>Fecha</th><th>Novedad</th><th>Expediente</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @foreach (var f in _resultado.Filas)
                {
                    <tr>
                        <td class="numero text-nowrap">@f.Fecha.ToString("dd/MM/yyyy")</td>
                        <td style="max-width: 460px">
                            <span class="principal-celda">@(f.Texto.Length > 200 ? f.Texto[..200] + "…" : f.Texto)</span>
                            @if (!f.Leida) { <span class="secundario" style="color: var(--p-azul); font-weight: 600">Sin revisar</span> }
                        </td>
                        <td>
                            @if (f.NroOrden is int n)
                            {
                                <a class="nro" href="/expedientes/@f.ExpedienteId">@n.ToString("D5")</a>
                            }
                            else
                            {
                                <span class="pastilla ambar">Sin vincular</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-column align-items-end gap-2">
                                @if (!f.Leida)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarcarAsync(f.Id)">Marcar revisada</button>
                                }
                                @if (f.ExpedienteId is null)
                                {
                                    <div class="input-group input-group-sm" style="width: 230px">
                                        <input class="form-control" placeholder="Nro de orden" aria-label="Nro de orden para vincular"
                                               value="@_nroPorNovedad.GetValueOrDefault(f.Id)"
                                               @onchange="e => _nroPorNovedad[f.Id] = e.Value?.ToString() ?? string.Empty" />
                                        <button class="btn btn-primary" @onclick="() => VincularAsync(f.Id)">Vincular</button>
                                    </div>
                                }
                                else if (!f.TieneTarea)
                                {
                                    <div class="input-group input-group-sm" style="width: 260px">
                                        <input class="form-control" type="date" aria-label="Vencimiento de la tarea" @bind="_venceFecha" />
                                        <button class="btn btn-primary" @onclick="() => CrearTareaAsync(f.Id)">Crear tarea</button>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Total="_resultado.Total" Pagina="_resultado.Pagina" Paginas="_resultado.Paginas" Tamanio="Tamanio"
               Enlace="p => Enlace(p, Tamanio)" EnlaceTamanio="t => Enlace(1, t)" />
}

@code {
    [SupplyParameterFromQuery(Name = "p")] public string? P { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? Pagina { get; set; }
    [SupplyParameterFromQuery(Name = "tam")] public int? Tam { get; set; }

    private bool _exito;
    private string? _mensaje;
    private string? _cargada;
    private Procu360.Infraestructura.Novedades.ResultadoNovedades? _resultado;
    private readonly Dictionary<long, string> _nroPorNovedad = new();
    private DateOnly _venceFecha = Procu360.Infraestructura.MiDia.ServicioMiDia.HoyEnCordoba().AddDays(7);

    private string _pestana => P is "revisadas" or "sin-vincular" ? P : "sin-revisar";

    private int Tamanio => Paginador.Tamanios.Contains(Tam ?? 0) ? Tam!.Value : 25;

    private string Enlace(int pagina, int tamanio) =>
        $"/novedades?p={_pestana}&pagina={pagina}" + (tamanio != 25 ? $"&tam={tamanio}" : "");

    private static Procu360.Infraestructura.Novedades.PestanaNovedades Pestana(string p) => p switch
    {
        "revisadas" => Procu360.Infraestructura.Novedades.PestanaNovedades.Revisadas,
        "sin-vincular" => Procu360.Infraestructura.Novedades.PestanaNovedades.SinVincular,
        _ => Procu360.Infraestructura.Novedades.PestanaNovedades.SinRevisar,
    };

    protected override async Task OnInitializedAsync()
    {
        // Contexto del circuito: el middleware solo corre en la primera request.
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        Procu360.Infraestructura.Identidad.SesionContexto.Aplicar(estado.User, Contexto);
    }

    /// <summary>
    /// Cambiar de bandeja o de página solo cambia la query (?p=, ?pagina=): Blazor reutiliza el componente,
    /// así que la carga va acá y no en OnInitializedAsync.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var clave = $"{_pestana}|{Pagina ?? 1}|{Tamanio}";
        if (clave == _cargada) return;
        if (_cargada is not null) _mensaje = null;
        await CargarAsync();
        _cargada = clave;
    }

    private async Task CargarAsync() =>
        _resultado = await Novedades.ListarAsync(Pestana(_pestana), Pagina ?? 1, Tamanio);

    private async Task MarcarAsync(long id)
    {
        var r = await Novedades.MarcarRevisadaAsync(id);
        await Informar(r, "Novedad marcada como revisada.");
    }

    private async Task VincularAsync(long id)
    {
        var texto = _nroPorNovedad.GetValueOrDefault(id)?.Trim() ?? string.Empty;
        if (!int.TryParse(texto, out var nro))
        {
            await Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion.Fallo("Ingresá el número de orden."), null);
            return;
        }
        // Solo expedientes dentro del alcance de la persona: la búsqueda ya filtra por alcance.
        var busqueda = await Busqueda.BuscarAsync(new Procu360.Infraestructura.Expedientes.CriteriosBusqueda(
            Texto: nro.ToString(), ComitenteId: null, InstanciaId: null, SinMovimiento: false,
            IncluirDadosDeBaja: false, Pagina: 1, TamanioPagina: 100));
        var expediente = busqueda.Filas.FirstOrDefault(f => f.NroOrden == nro);
        if (expediente is null)
        {
            await Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion.Fallo(
                "No encontramos ese expediente en tu alcance."), null);
            return;
        }

        var r = await Novedades.VincularAsync(id, expediente.Id);
        await Informar(r, "Novedad vinculada al expediente.");
    }

    private async Task CrearTareaAsync(long id)
    {
        var r = await Novedades.CrearTareaAsync(id, string.Empty, _venceFecha);
        await Informar(r, "Tarea creada desde la novedad.");
    }

    private async Task Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion r, string? ok)
    {
        _exito = r.Exito;
        _mensaje = r.Exito ? ok : r.Error;
        await CargarAsync();
    }
}
