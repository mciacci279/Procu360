@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject Procu360.Infraestructura.MiDia.ServicioMiDia MiDia
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto

<PageTitle>Mi día · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Mi día</h1>
        <p class="bajada">@FechaLarga · lo que hay que trabajar hoy</p>
    </div>
</div>

@if (_resumen is null)
{
    <div aria-busy="true" aria-label="Cargando tu resumen del día">
        <Esqueleto Tipo="Esqueleto.TipoEsqueleto.Tarjetas" Filas="3" />
    </div>
}
else if (_resumen.SinAlcance)
{
    <div class="alert alert-warning" role="alert">Tu rol no te da acceso a expedientes en este Estudio.</div>
}
else
{
    <div class="grilla-kpi">
        <Tarjeta Titulo="Vencimientos hoy" Valor="@_resumen.VencimientosHoy" Simbolo="reloj" Tono="rojo" Alerta="true"
                 Detalle="@($"{_resumen.VencimientosVencidos} vencidos")" />
        <Tarjeta Titulo="Novedades sin revisar" Valor="@_resumen.NovedadesSinRevisar" Simbolo="novedades" Tono="azul" />
        <Tarjeta Titulo="Etapas vencidas" Valor="@_resumen.EtapasVencidas" Simbolo="alerta" Tono="rojo" Alerta="true" />
        <Tarjeta Titulo="Sin movimiento" Valor="@_resumen.SinMovimiento" Simbolo="pausa" Tono="ambar"
                 Detalle="@($"más de {_resumen.DiasSinMovimiento} días")" />
        <Tarjeta Titulo="Perención próxima" Valor="@_resumen.PerencionProxima" Simbolo="reloj-arena" Tono="celeste"
                 Detalle="@($"alerta a {_resumen.DiasAlertaPerencion} días")" />
    </div>

    <div class="columnas">
        <section class="tarjeta principal entrar" aria-labelledby="titulo-tareas">
            <div class="cabecera-tarjeta">
                <h2 id="titulo-tareas">Vencimientos y tareas</h2>
                <a href="/tareas/calendario">Ver calendario</a>
            </div>
            @if (_resumen.Tareas.Count == 0)
            {
                <p class="text-muted mb-0">No hay tareas pendientes para hoy.</p>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="table">
                        <thead><tr><th>Expediente</th><th>Tarea</th><th>Vence</th></tr></thead>
                        <tbody>
                            @foreach (var t in _resumen.Tareas)
                            {
                                <tr>
                                    <td>
                                        @if (t.ExpedienteId is long eid && t.NroOrden is int n)
                                        {
                                            <a href="/expedientes/@eid">@n.ToString("D5")</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@t.Titulo</td>
                                    <td>
                                        @if (t.Vence == Hoy)
                                        {
                                            <span class="pastilla roja">Hoy</span>
                                        }
                                        else if (t.Vence < Hoy)
                                        {
                                            <span class="pastilla roja">Vencida · @t.Vence.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="numero">@t.Vence.ToString("dd/MM/yyyy")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tarjeta lateral entrar" aria-labelledby="titulo-novedades">
            <div class="cabecera-tarjeta">
                <h2 id="titulo-novedades">Novedades sin revisar</h2>
                <a href="/novedades">Ver todas</a>
            </div>
            @if (_resumen.Novedades.Count == 0)
            {
                <p class="text-muted mb-0">No hay novedades pendientes.</p>
            }
            else
            {
                <div class="lista-novedades">
                    @foreach (var n in _resumen.Novedades)
                    {
                        <a class="novedad-item" href="@(n.ExpedienteId is long e ? $"/expedientes/{e}" : "/novedades?p=sin-vincular")">
                            <span class="punto @(n.ExpedienteId is null ? "sin-vincular" : "")" aria-hidden="true"></span>
                            <span class="d-flex flex-column gap-1">
                                <span class="meta">
                                    @n.Fecha.ToString("dd/MM/yyyy")
                                    @if (n.ExpedienteId is null)
                                    {
                                        <span> · </span><span class="fw-semibold" style="color: var(--p-ambar-texto)">sin expediente vinculado</span>
                                    }
                                </span>
                                <span class="texto-novedad">@(n.Texto.Length > 120 ? n.Texto[..120] + "…" : n.Texto)</span>
                            </span>
                        </a>
                    }
                </div>
            }
        </section>
    </div>

    <section class="tarjeta entrar" aria-labelledby="titulo-perencion">
        <div class="cabecera-tarjeta">
            <h2 id="titulo-perencion">Perención</h2>
        </div>
        @if (_resumen.Perenciones.Count == 0)
        {
            <p class="text-muted mb-0">Ningún expediente vence su perención dentro de @_resumen.DiasAlertaPerencion días.</p>
        }
        else
        {
            <div class="tabla-contenedor">
                <table class="table">
                    <thead><tr><th>Expediente</th><th>Último corte</th><th>Vence</th></tr></thead>
                    <tbody>
                        @foreach (var p in _resumen.Perenciones)
                        {
                            <tr>
                                <td><a href="/expedientes/@p.ExpedienteId">@p.NroOrden.ToString("D5")</a></td>
                                <td class="numero">@p.UltimoCorte.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (p.Vence < Hoy)
                                    {
                                        <span class="pastilla roja">Vencida · @p.Vence.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="pastilla ambar">@p.Vence.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private static readonly System.Globalization.CultureInfo Argentina = new("es-AR");
    private static DateOnly Hoy => Procu360.Infraestructura.MiDia.ServicioMiDia.HoyEnCordoba();
    private Procu360.Infraestructura.MiDia.MiDiaResumen? _resumen;

    /// <summary>"Lunes 10 de noviembre": el día en palabras, con mayúscula inicial.</summary>
    private static string FechaLarga
    {
        get
        {
            var texto = Hoy.ToString("dddd d 'de' MMMM", Argentina);
            return char.ToUpper(texto[0], Argentina) + texto[1..];
        }
    }

    /// <summary>
    /// El resumen se pide después del primer dibujado: la pantalla aparece enseguida con su esqueleto.
    /// </summary>
    /// <summary>Contexto del circuito: al ser interactiva, el middleware solo corre en la primera request.</summary>
    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        Procu360.Infraestructura.Identidad.SesionContexto.Aplicar(estado.User, Contexto);
    }

    /// <summary>El resumen se pide después del primer dibujado: la pantalla aparece con su esqueleto.</summary>
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender || _resumen is not null) return;
        _resumen = await MiDia.ResumenAsync();
        StateHasChanged();
    }
}
