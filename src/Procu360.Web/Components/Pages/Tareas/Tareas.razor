@page "/tareas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = "tareas.consultar")]
@inject AuthenticationStateProvider AutenticacionProveedor
@inject ContextoEstudio Contexto
@inject Procu360.Infraestructura.Tareas.ServicioTareas Servicio
@inject ServicioPermisos Autorizacion

<PageTitle>Tareas · Procu360</PageTitle>

<div class="encabezado-pagina">
    <div>
        <h1>Tareas y agenda</h1>
        <p class="bajada">Lo pendiente del Estudio y de tus expedientes.</p>
    </div>
    <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="/tareas/calendario">
        <Icono Nombre="calendario" Tamano="18" /> Ver calendario
    </a>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_exito ? "alert-success" : "alert-danger")" role="status">@_mensaje</div>
}

<div class="columnas">
    <div class="principal">
        <div class="tarjeta panel-filtros">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="rotulo-filtros" style="font-size: 13px; font-weight: 600; color: var(--p-texto-tenue)">Ver</span>
                <div class="segmentado" role="group" aria-label="Filtro de tareas">
                    @foreach (var (filtro, nombre) in Filtros)
                    {
                        <button type="button" class="@(_filtro == filtro ? "activo" : "")" aria-pressed="@(_filtro == filtro ? "true" : "false")"
                                @onclick="() => CambiarFiltroAsync(filtro)">@nombre</button>
                    }
                </div>
            </div>
        </div>

        @if (_resultado is null)
        {
            <div class="tarjeta" aria-busy="true" aria-label="Cargando tareas">
                <Esqueleto Tipo="Esqueleto.TipoEsqueleto.Tabla" Filas="6" Columnas="5" />
            </div>
        }
        else if (_resultado.Total == 0)
        {
            <div class="tarjeta text-center py-5">
                <span class="icono-tono tono-verde mb-3" style="width: 52px; height: 52px; border-radius: 16px"><Icono Nombre="tareas" Tamano="24" Grosor="2" /></span>
                <p class="mb-0 fw-semibold">No hay tareas en esta vista.</p>
            </div>
        }
        else
        {
            <div class="resumen-resultados">
                <span><strong>@_resultado.Total</strong> tareas</span>
                <span>Página @_resultado.Pagina de @_resultado.Paginas</span>
            </div>
            <ZonaCargando Cargando="_cargando" Texto="Actualizando tareas…">
            <div class="tabla-contenedor">
                <table class="table">
                    <thead><tr><th>Vence</th><th>Tarea</th><th>Expediente</th><th>Responsable</th><th class="text-end">Estado</th></tr></thead>
                    <tbody>
                        @foreach (var t in _resultado.Filas)
                        {
                            <tr class="@(t.Vence is DateOnly v && v < Hoy && t.Estado == 1 ? "vencida" : "")">
                                <td>
                                    @if (t.Vence is DateOnly vence)
                                    {
                                        if (t.Estado == 1 && vence == Hoy)
                                        {
                                            <span class="pastilla roja">Hoy</span>
                                        }
                                        else if (t.Estado == 1 && vence < Hoy)
                                        {
                                            <span class="pastilla roja">Vencida · @vence.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="numero">@vence.ToString("dd/MM/yyyy")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    <span class="principal-celda">@t.Titulo</span>
                                    @if (t.VisibleParaTodos) { <span class="secundario">Visible para todo el Estudio</span> }
                                </td>
                                <td>
                                    @if (t.NroOrden is int n && t.ExpedienteId is long e)
                                    {
                                        <a class="nro" href="/expedientes/@e">@n.ToString("D5")</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(t.Responsable ?? "—")</td>
                                <td class="text-end">
                                    @if (t.Estado == 1 && _puedeEditar)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CumplirAsync(t.Id)">Marcar cumplida</button>
                                    }
                                    else if (t.Estado == 2)
                                    {
                                        <span class="pastilla verde">Cumplida</span>
                                    }
                                    else
                                    {
                                        <span class="pastilla ambar">Pendiente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </ZonaCargando>

            <Paginador Total="_resultado.Total" Pagina="_resultado.Pagina" Paginas="_resultado.Paginas" Tamanio="_tamanio"
                       IrAPagina="IrAsync" CambiarTamanio="CambiarTamanioAsync" />
        }
    </div>

    @if (_puedeCrear)
    {
        <div class="lateral">
            <section class="tarjeta panel-accion" aria-labelledby="titulo-nueva">
                <div class="cabecera-seccion">
                    <span class="icono-tono tono-azul"><Icono Nombre="mas" Tamano="18" Grosor="2.2" /></span>
                    <h2 id="titulo-nueva">Nueva tarea</h2>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="titulo">Título</label>
                    <input id="titulo" class="form-control" @bind="_nuevoTitulo" maxlength="150" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="vence">Vence</label>
                    <input id="vence" class="form-control" type="date" @bind="_nuevoVence" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="expediente">Nro de orden del expediente (opcional)</label>
                    <input id="expediente" class="form-control" @bind="_nuevoNro" />
                </div>
                <div class="mb-3">
                    <label class="chip-toggle">
                        <input type="checkbox" @bind="_nuevoParaTodos" />
                        <span>Visible para todo el Estudio (sin expediente)</span>
                    </label>
                </div>
                <button class="btn btn-primary w-100" @onclick="CrearAsync">Crear tarea</button>
            </section>
        </div>
    }
</div>

@code {
    private static readonly (Procu360.Infraestructura.Tareas.FiltroTareas, string)[] Filtros =
    [
        (Procu360.Infraestructura.Tareas.FiltroTareas.Pendientes, "Pendientes"),
        (Procu360.Infraestructura.Tareas.FiltroTareas.Vencidas, "Vencidas"),
        (Procu360.Infraestructura.Tareas.FiltroTareas.Hoy, "Vencen hoy"),
        (Procu360.Infraestructura.Tareas.FiltroTareas.Semana, "Próximos 7 días"),
        (Procu360.Infraestructura.Tareas.FiltroTareas.Cumplidas, "Cumplidas"),
        (Procu360.Infraestructura.Tareas.FiltroTareas.Todas, "Todas"),
    ];

    private Procu360.Infraestructura.Tareas.FiltroTareas _filtro = Procu360.Infraestructura.Tareas.FiltroTareas.Pendientes;
    private Procu360.Infraestructura.Tareas.ResultadoTareas? _resultado;
    private int _pagina = 1;
    private int _tamanio = 25;
    private bool _exito;
    private string? _mensaje;
    private bool _puedeCrear;
    private bool _puedeEditar;
    private string _nuevoTitulo = string.Empty;
    private DateOnly _nuevoVence = Procu360.Infraestructura.MiDia.ServicioMiDia.HoyEnCordoba().AddDays(7);
    private string _nuevoNro = string.Empty;
    private bool _nuevoParaTodos;

    private static DateOnly Hoy => Procu360.Infraestructura.MiDia.ServicioMiDia.HoyEnCordoba();

    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        Procu360.Infraestructura.Identidad.SesionContexto.Aplicar(estado.User, Contexto);
        _puedeCrear = await Autorizacion.TieneAsync("tareas.crear");
        _puedeEditar = await Autorizacion.TieneAsync("tareas.editar");
        await CargarAsync();
    }

    private bool _cargando;

    /// <summary>
    /// Marca la espera y redibuja antes de consultar: si no, Blazor dibuja recién al volver y el velo
    /// no llega a verse nunca.
    /// </summary>
    private async Task CargarAsync()
    {
        _cargando = true;
        StateHasChanged();
        try
        {
            _resultado = await Servicio.ListarAsync(_filtro, _pagina, _tamanio);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CambiarFiltroAsync(Procu360.Infraestructura.Tareas.FiltroTareas filtro)
    {
        _filtro = filtro;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task IrAsync(int pagina)
    {
        _pagina = pagina;
        await CargarAsync();
    }

    private async Task CambiarTamanioAsync(int tamanio)
    {
        _tamanio = tamanio;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CumplirAsync(long id)
    {
        var r = await Servicio.CumplirAsync(id);
        await Informar(r, "Tarea marcada como cumplida.");
    }

    private async Task CrearAsync()
    {
        long? expediente = null;
        if (!string.IsNullOrWhiteSpace(_nuevoNro))
        {
            if (!int.TryParse(_nuevoNro.Trim(), out var nro))
            {
                await Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion.Fallo("El número de orden no es válido."), null);
                return;
            }
            var busqueda = await Busqueda.BuscarAsync(new Procu360.Infraestructura.Expedientes.CriteriosBusqueda(
                nro.ToString(), null, null, false, false, 1, 100));
            expediente = busqueda.Filas.FirstOrDefault(f => f.NroOrden == nro)?.Id;
            if (expediente is null)
            {
                await Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion.Fallo(
                    "No encontramos ese expediente en tu alcance."), null);
                return;
            }
        }

        var r = await Servicio.CrearAsync(_nuevoTitulo, _nuevoVence, expediente, _nuevoParaTodos && expediente is null);
        if (r.Exito) { _nuevoTitulo = string.Empty; _nuevoNro = string.Empty; _nuevoParaTodos = false; }
        await Informar(r, "Tarea creada.");
    }

    private async Task Informar(Procu360.Infraestructura.Seguridad.ResultadoOperacion r, string? ok)
    {
        _exito = r.Exito;
        _mensaje = r.Exito ? ok : r.Error;
        await CargarAsync();
    }

    [Inject] private Procu360.Infraestructura.Expedientes.ServicioBusquedaExpedientes Busqueda { get; set; } = null!;
}
