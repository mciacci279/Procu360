@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AuthenticationStateProvider AutenticacionProveedor
@inject IServiceScopeFactory Ambitos
@inject IJSRuntime Js

<aside class="barra @(_plegada ? "plegada" : "")" aria-label="Navegación principal">
    <div class="cabecera-barra">
        <button type="button" class="boton-plegar" aria-expanded="@(!_plegada)"
                title="@(_plegada ? "Expandir menú" : "Plegar menú") ( [ )"
                @onclick="AlternarAsync">
            <Icono Nombre="menu" Grosor="2" />
            <span class="visually-hidden">@(_plegada ? "Expandir menú" : "Plegar menú")</span>
        </button>
        @* Logo acordeón: arranca como P360 y se abre a Procu360. Plegado, queda en vertical. *@
        <a class="@ClaseLogo" href="/" aria-label="Procu360, inicio">
            <span>P</span><span class="logo-rocu" aria-hidden="true">rocu</span><span class="logo-360">360</span>
        </a>
    </div>

    <nav>
        <div class="grupo texto">Trabajo diario</div>
        <NavLink class="item" href="/" Match="NavLinkMatch.All" title="Mi día">
            <Icono Nombre="inicio" /><span class="texto">Mi día</span>
        </NavLink>
        @if (_puedeConsultarExpedientes)
        {
            <NavLink class="item" href="expedientes" title="Expedientes">
                <Icono Nombre="expedientes" /><span class="texto">Expedientes</span>
            </NavLink>
            <NavLink class="item" href="diligencias" title="Diligencias: cédulas y oficios">
                <Icono Nombre="diligencias" /><span class="texto">Diligencias</span>
            </NavLink>
        }
        @if (_puedeConsultarTareas)
        {
            <NavLink class="item" href="tareas" title="Tareas y agenda">
                <Icono Nombre="tareas" /><span class="texto">Tareas</span>
            </NavLink>
        }
        @if (_puedeConsultarNovedades)
        {
            <NavLink class="item" href="novedades" title="Novedades">
                <Icono Nombre="novedades" /><span class="texto">Novedades</span>
            </NavLink>
        }

        @if (_puedeInvitar || _puedeAdministrar || _puedeConfigurar)
        {
            <div class="grupo texto">Administración</div>
            @if (_puedeInvitar)
            {
                <NavLink class="item" href="estudio/invitaciones" title="Invitaciones">
                    <Icono Nombre="invitaciones" /><span class="texto">Invitaciones</span>
                </NavLink>
            }
            @if (_puedeAdministrar)
            {
                <NavLink class="item" href="estudio/usuarios" title="Usuarios del Estudio">
                    <Icono Nombre="usuarios" /><span class="texto">Usuarios</span>
                </NavLink>
                <NavLink class="item" href="estudio/roles" title="Roles y permisos">
                    <Icono Nombre="roles" /><span class="texto">Roles y permisos</span>
                </NavLink>
            }
            @if (_puedeConfigurar)
            {
                <NavLink class="item" href="estudio/etapas" title="Etapas e instancias">
                    <Icono Nombre="linea" /><span class="texto">Etapas e instancias</span>
                </NavLink>
            }
        }
    </nav>

    <div class="pie">
        @if (_perfil is not null)
        {
            <div class="perfil" title="@_perfil.NombreCompleto · @_perfil.NombreEstudio">
                <span class="avatar" aria-hidden="true">@Iniciales(_perfil.NombreCompleto)</span>
                <span class="texto datos-perfil">
                    <span class="nombre">@_perfil.NombreCompleto</span>
                    <span class="estudio">@_perfil.NombreEstudio · @string.Join(", ", _perfil.Roles)</span>
                </span>
            </div>
        }
        else
        {
            <a class="item" href="cuenta/estudio"><Icono Nombre="expedientes" /><span class="texto">Elegir Estudio</span></a>
        }
        <form method="post" action="/cuenta/salir">
            <AntiforgeryToken />
            <button type="submit" class="item" title="Salir">
                <Icono Nombre="salir" /><span class="texto">Salir</span>
            </button>
        </form>
    </div>
</aside>

@code {
    private bool _plegada;
    private bool _logoAbierto;
    private bool _logoSinTransicion;
    private bool _puedeInvitar;
    private bool _puedeAdministrar;
    private bool _puedeConfigurar;
    private bool _puedeConsultarExpedientes;
    private bool _puedeConsultarNovedades;
    private bool _puedeConsultarTareas;
    private PerfilSesion? _perfil;
    private int? _usuarioId;
    private IJSObjectReference? _modulo;
    private DotNetObjectReference<BarraLateral>? _referencia;
    private readonly CancellationTokenSource _cierre = new();

    private string ClaseLogo =>
        "logo" + (_logoAbierto && !_plegada ? " abierto" : "") + (_logoSinTransicion ? " sin-transicion" : "");

    /// <summary>
    /// Permisos y perfil se calculan en un ámbito propio, separado del de la página:
    /// así no comparten DbContext con otros componentes de la misma circuito.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var estado = await AutenticacionProveedor.GetAuthenticationStateAsync();
        if (estado.User.Identity?.IsAuthenticated != true) return;

        await using var ambito = Ambitos.CreateAsyncScope();
        var contexto = ambito.ServiceProvider.GetRequiredService<ContextoEstudio>();
        if (!SesionContexto.Aplicar(estado.User, contexto)) return;

        _usuarioId = SesionContexto.UsuarioId(estado.User);
        var permisos = ambito.ServiceProvider.GetRequiredService<ServicioPermisos>();
        _puedeInvitar = await permisos.TieneAsync(Procu360.Dominio.Seguridad.Permisos.UsuariosCrear);
        _puedeAdministrar = await permisos.TieneAsync(Procu360.Dominio.Seguridad.Permisos.UsuariosAdministrar);
        _puedeConfigurar = await permisos.TieneAsync(Procu360.Dominio.Seguridad.Permisos.ConfiguracionAdministrar);
        _puedeConsultarExpedientes = await permisos.TieneAsync("expedientes.consultar");
        _puedeConsultarNovedades = await permisos.TieneAsync("novedades.consultar");
        _puedeConsultarTareas = await permisos.TieneAsync("tareas.consultar");

        if (SesionContexto.EstudioId(estado.User) is int estudio && _usuarioId is int usuario)
        {
            _perfil = await ambito.ServiceProvider.GetRequiredService<ServicioSesion>().PerfilAsync(usuario, estudio);
        }
    }

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender || _usuarioId is null) return;

        _modulo = await Js.InvokeAsync<IJSObjectReference>("import", "./js/menu.js");
        var preferencia = await _modulo.InvokeAsync<string?>("leerPreferencia", ClavePreferencia);
        // Sin preferencia guardada: plegada en pantallas menores de 1280 px (docs/02 §2.1).
        _plegada = preferencia is null
            ? await _modulo.InvokeAsync<int>("anchoVentana") < 1280
            : preferencia == "1";

        _referencia = DotNetObjectReference.Create(this);
        await _modulo.InvokeVoidAsync("registrarAtajo", _referencia);
        await _modulo.InvokeVoidAsync("vigilarDesborde");

        // El acordeón del logo se muestra una vez por sesión del navegador; después aparece ya abierto.
        if (await _modulo.InvokeAsync<bool>("logoYaAnimado"))
        {
            _logoSinTransicion = true;
            _logoAbierto = true;
            StateHasChanged();
            return;
        }

        StateHasChanged();
        await AbrirLogoConDemoraAsync(1000);
        await _modulo.InvokeVoidAsync("marcarLogoAnimado");
    }

    private string ClavePreferencia => $"procu360.menu.{_usuarioId}";

    private async Task AlternarAsync()
    {
        if (_plegada)
        {
            // Al expandir, el logo vuelve a P360 y se abre cuando la barra ya tomó su ancho.
            _plegada = false;
            _logoAbierto = false;
            _logoSinTransicion = false;
            StateHasChanged();
            await GuardarPreferenciaAsync();
            await AbrirLogoConDemoraAsync(450);
        }
        else
        {
            _plegada = true;
            await GuardarPreferenciaAsync();
        }
    }

    private async Task AbrirLogoConDemoraAsync(int milisegundos)
    {
        try
        {
            await Task.Delay(milisegundos, _cierre.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _logoAbierto = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task GuardarPreferenciaAsync()
    {
        if (_modulo is not null)
        {
            await _modulo.InvokeVoidAsync("guardarPreferencia", ClavePreferencia, _plegada ? "1" : "0");
        }
    }

    private static string Iniciales(string nombre)
    {
        // Solo palabras que empiezan con letra (mismo criterio que la ficha).
        var partes = (nombre ?? string.Empty)
            .Split([' ', ',', '.', '-', '/'], StringSplitOptions.RemoveEmptyEntries)
            .Where(p => char.IsLetter(p[0]))
            .ToArray();
        return partes.Length switch
        {
            0 => "?",
            1 => char.ToUpperInvariant(partes[0][0]).ToString(),
            _ => string.Concat(char.ToUpperInvariant(partes[0][0]), char.ToUpperInvariant(partes[^1][0]))
        };
    }

    /// <summary>Llamado desde JavaScript con la tecla "[".</summary>
    [JSInvokable]
    public async Task AlternarDesdeAtajoAsync()
    {
        await InvokeAsync(AlternarAsync);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _cierre.Cancel();
        _cierre.Dispose();
        _referencia?.Dispose();
        if (_modulo is not null)
        {
            try
            {
                await _modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró al navegar: no hay módulo que liberar del lado del navegador.
            }
        }
    }
}
