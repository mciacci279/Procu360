@* Íconos de trazo (SVG en línea). Toman el color del texto que los rodea; son decorativos (aria-hidden). *@
<svg width="@Tamano" height="@Tamano" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Grosor.ToString(System.Globalization.CultureInfo.InvariantCulture)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Nombre)
    {
        case "inicio":
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" />
            break;
        case "expedientes":
            <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2h8.5A1.5 1.5 0 0 1 21 8.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z" />
            break;
        case "diligencias":
            <path d="M12 3 21 12 12 21 3 12z" />
            break;
        case "tareas":
            <rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="m8 12 3 3 5-6" />
            break;
        case "novedades":
            <path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8" /><path d="M10 20a2 2 0 0 0 4 0" />
            break;
        case "invitaciones":
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
            break;
        case "usuarios":
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6" />
            break;
        case "roles":
            <circle cx="8" cy="15" r="4" /><path d="m11 12 9-9M17 6l3 3M15 8l2 2" />
            break;
        case "salir":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="m10 16-4-4 4-4M6 12h10" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "reloj":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "pausa":
            <circle cx="12" cy="12" r="9" /><path d="M10 9v6M14 9v6" />
            break;
        case "alerta":
            <path d="M12 3 2 20h20z" /><path d="M12 10v4M12 17h.01" />
            break;
        case "reloj-arena":
            <path d="M6 3h12M6 21h12M7 3c0 5 10 6 10 9s-10 4-10 9M17 3c0 5-10 6-10 9s10 4 10 9" />
            break;
        case "buscar":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            break;
        case "resumen":
            <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
            break;
        case "linea":
            <circle cx="6" cy="6" r="2.5" /><circle cx="6" cy="18" r="2.5" /><path d="M6 8.5v7M11 6h9M11 18h9M11 12h6" />
            break;
        case "balanza":
            <path d="M12 3v18M7 21h10M5 7h14" /><path d="m5 7-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z" />
            break;
        case "moneda":
            <circle cx="12" cy="12" r="9" /><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.4 0-2.5.8-2.5 2s1.1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.5-2.5-1.5M12 6.5v1.5M12 16v1.5" />
            break;
        case "ubicacion":
            <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
            break;
        case "nota":
            <path d="M5 4h14v12l-4 4H5z" /><path d="M15 20v-4h4M8.5 9h7M8.5 13h4" />
            break;
        case "mas":
            <path d="M12 5v14M5 12h14" />
            break;
        case "flecha":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "volver":
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case "candado":
            <rect x="4.5" y="10.5" width="15" height="10" rx="2" /><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
            break;
        case "escudo":
            <path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z" /><path d="m9 12 2 2 4-4" />
            break;
        case "filtro":
            <path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" />
            break;
        case "calendario":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" />
            break;
        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter] public int Tamano { get; set; } = 20;
    [Parameter] public double Grosor { get; set; } = 1.8;
}
